# ============================================================================
# PC Monitor on Waveshare ESP32-S3-Touch-AMOLED-1.75C
# ESP32-S3R8, 8MB octal PSRAM, 32MB flash
# ============================================================================

CONFIG_IDF_TARGET="esp32s3"

# 32MB quad flash, matching the module on this board
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# Octal PSRAM at 80 MHz (ESP32-S3R8). Cache geometry is required for that mode.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# app_main builds every page and calls lv_refr_now before the panel is turned on.
# 3584 overflowed once the settings slider was drawn, so the panel stayed off.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Logging: WARN. INFO logs share the USB channel with protocol responses
# (IMG_OK/FW_OK) and can corrupt ACK lines mid-transfer.
CONFIG_LOG_DEFAULT_LEVEL_WARN=y

# At 100 Hz, pdMS_TO_TICKS(1..9) truncates to 0 ticks.
CONFIG_FREERTOS_HZ=1000

# One QSPI transfer in flight, and a 25 ms LVGL period, matching the
# Waveshare 1.75C board port that gates flushes on the panel TE pin.
CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH=1
CONFIG_LV_DEF_REFR_PERIOD=25

CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Native USB Serial/JTAG (GPIO19/20) still flashes and carries the same
# text protocol. Bluetooth LE is a second way in for that protocol.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_BT_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
CONFIG_BT_NIMBLE_ENABLED=y
# The USB port resets the chip. Bonds must survive that, or the next
# Bluetooth connection cannot encrypt.
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_CONTROLLER_ENABLED=y

# Partition table: OTA slots + LittleFS
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Fonts used by the four gauges. LVGL is configured from Kconfig.
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_26=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_34=y
CONFIG_LV_FONT_MONTSERRAT_42=y
